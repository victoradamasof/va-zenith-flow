{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "va-consultoria-manager",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "manager.agenciablackbelt.com.br",
      "custom_domain": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "VA_MANAGER_DATA",
      "id": "f5d6a8baa00d4b10974459e634a832ce",
    },
  ],
}
